###############################################################################
# CyberRepo configuration
#
# This file is downloaded by cloud-init from:
# https://raw.githubusercontent.com/EUD-cyber/eud-cyber/main/IMAGESRV/config.env
###############################################################################

###############################################################################
# Network
###############################################################################

# "auto" uses the interface containing the default route.
#
# You can also force an interface:
# REPO_INTERFACE="eth0"
# REPO_INTERFACE="ens18"
REPO_INTERFACE="auto"

# Protocol used by clients when downloading files.
REPO_SCHEME="http"

# Optional hostname/IP override.
#
# Leave empty to use the detected IPv4 address.
#
# Example:
# REPO_HOST_OVERRIDE="repo.cyberlab.local"
REPO_HOST_OVERRIDE=""

###############################################################################
# Repository
###############################################################################

REPO_NAME="CyberRepo"
REPO_ROOT="/srv/cyberrepo"

# HTTP port used by Nginx.
REPO_HTTP_PORT="80"

###############################################################################
# Docker Registry
###############################################################################

ENABLE_REGISTRY="yes"

# Registry host is detected automatically when this is empty.
#
# Example:
# REGISTRY_HOST_OVERRIDE="repo.cyberlab.local"
REGISTRY_HOST_OVERRIDE=""

REGISTRY_PORT="5000"

###############################################################################
# Ubuntu image
###############################################################################

DOWNLOAD_UBUNTU="yes"

UBUNTU_IMAGE_URL="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"

UBUNTU_IMAGE_NAME="ubuntu-24.04-server-cloudimg-amd64.img"

###############################################################################
# Kali image
###############################################################################

# Insert the direct URL to the image when it is available.
DOWNLOAD_KALI="no"

KALI_IMAGE_URL=""

KALI_IMAGE_NAME="kali-cloud.qcow2"

###############################################################################
# OPNsense image
###############################################################################

# Insert a direct URL to an ISO, QCOW2 or compressed image.
DOWNLOAD_OPNSENSE="no"

OPNSENSE_IMAGE_URL=""

OPNSENSE_IMAGE_NAME="opnsense.qcow2"

###############################################################################
# Wazuh image
###############################################################################

DOWNLOAD_WAZUH="no"

WAZUH_IMAGE_URL=""

WAZUH_IMAGE_NAME="wazuh.qcow2"

###############################################################################
# Windows images
###############################################################################

DOWNLOAD_WINDOWS="no"

WINDOWS_IMAGE_URL=""

WINDOWS_IMAGE_NAME="windows.qcow2"

###############################################################################
# Additional images
#
# Format:
# "enabled|name|url|relative destination"
#
# Examples:
# "yes|Client Ubuntu|https://server/client.qcow2|images/ubuntu/client.qcow2"
# "yes|Windows 11|https://server/win11.qcow2|images/windows/win11.qcow2"
###############################################################################

ADDITIONAL_IMAGES=(
)

###############################################################################
# Docker images cached in the private registry
#
# Format:
# "source image|name inside local registry"
###############################################################################

DOCKER_IMAGES=(
  "nginx:alpine|nginx:alpine"
  "postgres:16-alpine|postgres:16-alpine"
  "guacamole/guacamole:1.6.0|guacamole:1.6.0"
  "guacamole/guacd:1.6.0|guacd:1.6.0"
  "portainer/portainer-ce:lts|portainer:lts"
  "portainer/agent:lts|portainer-agent:lts"
  "python:3.12-alpine|python:3.12-alpine"
  "registry:2|registry:2"
)

###############################################################################
# Repository metadata
###############################################################################

GENERATE_SHA256="yes"
GENERATE_MANIFEST="yes"

###############################################################################
# Automatic update
###############################################################################

# Refresh repository metadata daily.
DAILY_UPDATE="yes"

# Also fetch config.env again from GitHub during the daily update.
DAILY_CONFIG_UPDATE="no"

# Automatically attempt to cache Docker images during daily update.
DAILY_DOCKER_CACHE="no"